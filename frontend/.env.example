# Base URL của backend (đã gồm /api/v1)
VITE_API_URL=http://localhost:8080/api/v1

# Google OAuth Client ID (loại Web application, không phải secret), cùng giá trị với GOOGLE_CLIENT_ID của backend.
# Để trống thì ẩn nút "Tiếp tục với Google". Client secret chỉ đặt ở backend (GOOGLE_CLIENT_SECRET), không đặt ở đây.
VITE_GOOGLE_CLIENT_ID=
# Redirect URI khai trong Google Console, trùng GOOGLE_REDIRECT_URI của backend. Bỏ trống thì dùng <origin>/authenticate.
VITE_GOOGLE_REDIRECT_URI=
