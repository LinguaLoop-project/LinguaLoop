{
  "git": {
    "deploymentEnabled": {
      "main": false,
      "develop": false
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://lingualoop-backend-u275.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
