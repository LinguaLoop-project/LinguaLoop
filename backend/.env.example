#============
# Spring
#============
SPRING_PROFILES_ACTIVE=prod
SPRING_DOCKER_COMPOSE_ENABLED=false
PORT=8080

#============
# Database
#============
DB_URL=jdbc:postgresql://<host>:5432/lingualoop
DB_USERNAME=
DB_PASSWORD=

#============
# Security
#============
JWT_SECRET=

#============
# Web
#============
CORS_ALLOWED_ORIGINS=

#============
# Auth
#============
# Gốc URL frontend, dùng dựng link trong thư (vd https://lingualoop.vercel.app)
FRONTEND_URL=

#============
# Google
#============
# Authorization code flow. Client ID loại Web application, cùng giá trị với VITE_GOOGLE_CLIENT_ID ở frontend.
# Thiếu CLIENT_ID hoặc CLIENT_SECRET thì đăng nhập Google báo "tạm thời không dùng được", phần còn lại của app vẫn chạy.
GOOGLE_CLIENT_ID=
# SECRET: chỉ đặt ở môi trường chạy, không commit, không đưa lên frontend.
GOOGLE_CLIENT_SECRET=
# Phải trùng VITE_GOOGLE_REDIRECT_URI (hoặc <origin>/authenticate) và đã khai trong Google Console. Local mặc định http://localhost:5173/authenticate
GOOGLE_REDIRECT_URI=

#============
# Mail (SMTP)
#============
# Local không cần khai báo: mặc định trỏ Mailpit localhost:1025 (xem thư tại http://localhost:8025)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@lingualoop.app
