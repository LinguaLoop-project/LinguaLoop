#============
# Spring
#============
SPRING_PROFILES_ACTIVE=prod
SPRING_DOCKER_COMPOSE_ENABLED=false
PORT=8080

#============
# Database
#============
DB_URL=jdbc:postgresql://<host>:5432/lingualoop
DB_USERNAME=
DB_PASSWORD=

#============
# Security
#============
JWT_SECRET=

#============
# Web
#============
CORS_ALLOWED_ORIGINS=

#============
# Auth
#============
# Gốc URL frontend, dùng dựng link trong thư (vd https://lingualoop.vercel.app)
FRONTEND_URL=

#============
# Mail (SMTP)
#============
# Local không cần khai báo: mặc định trỏ Mailpit localhost:1025 (xem thư tại http://localhost:8025)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@lingualoop.app
