SPRING_PROFILES_ACTIVE=dev

# ---- Khóa dịch vụ ngoài (dùng cho cả dev và prod) ----

# Azure Speech (chấm phát âm shadowing). Azure Portal > resource Speech > Keys and Endpoint. Thiếu thì chấm báo lỗi.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Gemini (Nhận xét AI). Google AI Studio > Get API key. Thiếu thì nhận xét AI báo "tạm thời không dùng được".
GEMINI_API_KEY=

# Audio từ điển (S3/CDN), vd https://cdn.example.com/dictionary/. Thiếu thì tự rơi về giọng đọc trình duyệt.
AUDIO_BASE_URL=

# ---- DEPLOY (chỉ cần khi SPRING_PROFILES_ACTIVE=prod; dev bỏ qua, không set) ----

# Postgres thật (vd RDS/Supabase). Bắt buộc, prod không có default.
DB_URL=jdbc:postgresql://<host>:5432/<db>
DB_USERNAME=
DB_PASSWORD=

# Port server lắng nghe. Không set thì mặc định 8080.
PORT=8080

# Bắt buộc, dùng ký JWT access token. Đổi là mọi token cũ bị invalid.
JWT_SECRET=

# Domain FE được phép gọi API (CORS), vd https://lingualoop.app. Bắt buộc.
CORS_ALLOWED_ORIGINS=

# Link FE để build các URL gửi trong mail (reset password, xác thực...). Bắt buộc.
FRONTEND_URL=

# SMTP gửi mail thật (dev dùng Mailpit, không cần set các biến này). MAIL_HOST bắt buộc.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@lingualoop.app

# Google OAuth login. Google Cloud Console > OAuth client. Thiếu thì tắt được nút "Đăng nhập Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# S3 lưu tệp người dùng tải lên (presigned URL). IAM user chỉ cần s3:PutObject, s3:GetObject, s3:DeleteObject trên
# bucket này. Bucket phải bật CORS cho FRONTEND_URL (PUT, GET; header Content-Type). Thiếu bucket thì tải tệp báo lỗi.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=
# Gốc URL đọc ảnh công khai. Để trống là https://<AWS_S3_BUCKET>.s3.<AWS_REGION>.amazonaws.com/ (đặt khi dùng CloudFront).
AWS_S3_PUBLIC_BASE_URL=

