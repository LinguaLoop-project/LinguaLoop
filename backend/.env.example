#============
# Spring Boot
#============
# Môi trường chạy ứng dụng: prod, dev hoặc test.
SPRING_PROFILES_ACTIVE=prod

# Tắt tự động khởi chạy Docker Compose của Spring Boot.
SPRING_DOCKER_COMPOSE_ENABLED=false

# Cổng mà ứng dụng backend sử dụng.
PORT=8080

#============
# Database
#============
# Chuỗi kết nối PostgreSQL, bao gồm máy chủ, cổng và tên database.
DB_URL=jdbc:postgresql://<host>:5432/lingualoop

# Tên tài khoản dùng để kết nối database.
DB_USERNAME=

# Mật khẩu của tài khoản database.
DB_PASSWORD=

#============
# Security
#============
# Khóa bí mật dùng để ký và xác minh JWT.
# Phải đủ mạnh, được giữ bí mật và không đưa lên Git.
JWT_SECRET=

#============
# Web
#============
# Danh sách origin frontend được phép gọi API backend qua CORS.
# Nếu có nhiều origin, hãy phân tách theo định dạng mà ứng dụng hỗ trợ.
CORS_ALLOWED_ORIGINS=

#============
# Auth
#============
# URL gốc của frontend, dùng để tạo liên kết trong email xác thực
# tài khoản hoặc đặt lại mật khẩu.
# Ví dụ: https://lingualoop.vercel.app
FRONTEND_URL=

#============
# Google OAuth
#============
# Client ID của OAuth 2.0 loại Web application.
# Giá trị này phải khớp với VITE_GOOGLE_CLIENT_ID ở frontend.
# Nếu thiếu Client ID hoặc Client Secret, chức năng đăng nhập Google
# có thể không hoạt động; các chức năng khác vẫn có thể sử dụng bình thường.
GOOGLE_CLIENT_ID=

# Client Secret dùng để backend xác thực với Google.
# Chỉ cấu hình trong môi trường chạy backend; tuyệt đối không đưa lên frontend
# hoặc commit lên Git.
GOOGLE_CLIENT_SECRET=

# URI Google chuyển hướng người dùng về sau khi xác thực.
# Phải khớp với VITE_GOOGLE_REDIRECT_URI ở frontend và URI đã đăng ký
# trong Google Cloud Console.
# URI mặc định khi chạy local: http://localhost:5173/authenticate
GOOGLE_REDIRECT_URI=

#============
# Audio (S3/CDN cho từ điển)
#============
# URL gốc chứa các file audio phát âm.
# Ví dụ: https://cdn.example.com/dictionary/
# Backend ghép URL này với đường dẫn tương đối được lưu trong database,
# chẳng hạn audio/hello-us.mp3; không trực tiếp tải file từ AWS bằng SDK.
# Để trống nếu môi trường local hoặc test chưa sử dụng CDN.
AUDIO_BASE_URL=

#============
# Mail (SMTP)
#============
# Máy chủ SMTP dùng để gửi email.
# Khi chạy local, nếu không cấu hình riêng, ứng dụng mặc định sử dụng
# Mailpit tại localhost:1025 (nếu được thiết lập trong mã nguồn).
MAIL_HOST=

# Cổng SMTP của máy chủ email.
# Cổng 587 thường được dùng với STARTTLS.
MAIL_PORT=587

# Tài khoản đăng nhập máy chủ SMTP.
MAIL_USERNAME=

# Mật khẩu hoặc thông tin xác thực SMTP.
# Không commit giá trị thật lên Git.
MAIL_PASSWORD=

# Địa chỉ email hiển thị ở trường người gửi.
# Cần sử dụng tên miền hợp lệ và được cấu hình phù hợp với dịch vụ gửi mail.
MAIL_FROM=no-reply@lingualoop.app
