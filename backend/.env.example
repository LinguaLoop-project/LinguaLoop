# Sao chép thành backend/.env (đã bị .gitignore). Backend tự đọc file này lúc khởi động (spring.config.import trong
# application.yml), nên các biến dưới đây dùng được trong mọi file yml mà không phải đặt vào IDE hay terminal.
#
# Thứ tự ưu tiên (cao thắng thấp): tham số dòng lệnh > biến môi trường của hệ điều hành/IDE > .env > giá trị mặc định
# trong yml. Chạy trong backend/ thì đọc ./.env, chạy từ thư mục gốc thì đọc backend/.env; đặt DOTENV_DIR để đổi thư mục.
# Bộ test tự bỏ qua .env.
#
# QUY TẮC QUAN TRỌNG: dòng để trống (KEY=) là giá trị RỖNG, không phải "chưa đặt". Nó che mất giá trị mặc định của
# profile dev (vd JWT_SECRET) và làm app không khởi động được. Vì vậy chỉ giữ dòng nào bạn thật sự có giá trị;
# biến nào muốn dùng mặc định thì không khai báo hoặc để dạng chú thích (# KEY=).
# Giá trị có dấu \ phải viết \\ (định dạng .properties). Không dùng dấu nháy bao quanh giá trị.

#=====================================================================
# CHẠY LOCAL (profile dev): chỉ cần các dòng này
#=====================================================================
# dev = Postgres + Mailpit tự bật từ backend/compose.yaml (cần Docker Desktop), có sẵn giá trị mặc định cho JWT,
# CORS, link frontend... và bật nút thử Free/Pro. Mọi biến ở phần deploy bên dưới KHÔNG cần khi chạy local.
SPRING_PROFILES_ACTIVE=dev

# Azure Speech (chấm phát âm shadowing). Lấy ở Azure Portal > resource Speech > Keys and Endpoint.
# Để trống key thì chấm báo "dịch vụ chấm tạm thời không dùng được". Region phải đúng nơi tạo resource.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Gemini (Nhận xét AI về lượt đọc). Lấy ở Google AI Studio > Get API key. Để trống thì nhận xét AI báo
# "dịch vụ tạm thời không dùng được". Đổi model văn bản bằng GEMINI_TEXT_MODEL (mặc định gemini-2.5-flash).
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=
# Model dùng cho lần thử lại khi model chính quá tải (503/429). Để trống thì thử lại bằng model chính.
# GEMINI_FALLBACK_MODEL=

#=====================================================================
# DEPLOY (profile prod): bỏ dấu # và điền giá trị. Không bật các dòng này khi chạy local.
#=====================================================================
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DOCKER_COMPOSE_ENABLED=false
# PORT=8080

# Database (nếu là DB thật thì chạy prod sẽ ghi vào đó)
# DB_URL=jdbc:postgresql://<host>:5432/lingualoop
# DB_USERNAME=
# DB_PASSWORD=

# Security
# JWT_SECRET=

# Web
# CORS_ALLOWED_ORIGINS=

# Gốc URL frontend, dùng dựng link trong thư (vd https://lingualoop.vercel.app)
# FRONTEND_URL=

# Google: authorization code flow. Client ID loại Web application, cùng giá trị với VITE_GOOGLE_CLIENT_ID ở frontend.
# Thiếu CLIENT_ID hoặc CLIENT_SECRET thì đăng nhập Google báo "tạm thời không dùng được", phần còn lại của app vẫn chạy.
# GOOGLE_CLIENT_ID=
# SECRET: chỉ đặt ở môi trường chạy, không commit, không đưa lên frontend.
# GOOGLE_CLIENT_SECRET=
# Phải trùng VITE_GOOGLE_REDIRECT_URI (hoặc <origin>/authenticate) và đã khai trong Google Console.
# GOOGLE_REDIRECT_URI=

# Mail (SMTP). Local không cần: mặc định trỏ Mailpit localhost:1025 (xem thư tại http://localhost:8025).
# Đừng đặt MAIL_PORT=587 khi chạy local, nó sẽ làm gửi thư tới Mailpit thất bại.
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@lingualoop.app
